[Unit]
Description=Create and verify a CutiePi production backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/cutie-pi/backup.env
ExecStart=/usr/local/sbin/cutie-pi-backup
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/backups
